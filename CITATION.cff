    given-names: D. Cale
    orcid: "https://orcid.org/0000-0001-5156-594X"
repository-code: "https://github.com/dcaler/haarpi"
url: "https://github.com/dcaler/haarpi"
license-url: "https://polyformproject.org/licenses/noncommercial/1.0.0"
keywords:
  - research software
  - agentic workflows
  - large language models
  - reproducible research
  - human-in-the-loop
version: 0.1.0
date-released: "2026-09-13"
