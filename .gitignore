# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# macOS / sync litter
.DS_Store
._*
@eaDir/

# generated figure pool — per-project diagram artifacts, rebuilt from source, not tracked.
# The two ARCHITECTURE figures are the exception: the README embeds them, so they ship with
# the source they were rendered from (see the README-check SOP — a stale figure in the README
# is worse than no figure).
/figures/*
!/figures/*_agentDrilldown_ra.dot
!/figures/*_agentDrilldown_ra.png
!/figures/*_agentDrilldown_ra.svg
!/figures/*_paperInflow_ra.dot
!/figures/*_paperInflow_ra.png
!/figures/*_paperInflow_ra.svg

# Word lock files
~$*

# local tool state
.claude/

# workflow handoff — never committed (see GitHub rules)
HANDOFF.md
DIAGNOSIS.md
LITREVIEW_REPAIR_PLAN.md

# trained author-voice profiles + their data — personal, never committed. These live in
# ~/.config/haarpi/ (outside any repo); this is belt-and-suspenders against a stray copy.
style_profile.md
*.md.bak

# proprietary branding — deck masters, logos, example decks, and any master-format descriptor are
# licensed/PII and live in ~/.config/haarpi/razzle/ (outside any repo). NEVER commit — belt-and-
# suspenders against a stray copy landing in the repo dir.
*.pptx
/logos/
/razzle_demo.pptx
