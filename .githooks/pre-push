#!/usr/bin/env bash
# Dispatcher. See .githooks/commit-msg for why this exists: core.hooksPath=.githooks
# overrides ~/.config/git/hooks entirely, so the machine-wide push guard has to be
# re-entered from here.
#
# The rule lives in ~/.claude/CLAUDE.md: never push a *@localhost identity. The tool
# identities (rabbithole, rayleigh, raster, raconteur) are for local-only history.
set -euo pipefail
GLOBAL_HOOK="${HOME}/.config/git/hooks/pre-push"

if [ -x "$GLOBAL_HOOK" ]; then
  "$GLOBAL_HOOK" "$@"
else
  # Fallback: a minimal version of the same check, so a missing global hook downgrades
  # the message rather than the enforcement.
  remote="$1"
  zero='0000000000000000000000000000000000000000'
  bad=0
  while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$zero" ] && continue
    if [ "$rsha" = "$zero" ]; then
      range=$(git rev-list "$lsha" --not --remotes="$remote" || true)
    else
      range=$(git rev-list "${rsha}..${lsha}" || true)
    fi
    [ -z "$range" ] && continue
    while read -r sha; do
      [ -z "$sha" ] && continue
      ae=$(git log -1 --format='%ae' "$sha"); ce=$(git log -1 --format='%ce' "$sha")
      if [[ "$ae" == *@localhost || "$ce" == *@localhost ]]; then
        echo "  PUSH REJECTED — *@localhost identity: $(git log -1 --format='%h %an <%ae>' "$sha")" >&2
        bad=$((bad + 1))
      fi
    done <<< "$range"
  done
  [ "$bad" -gt 0 ] && exit 1
fi
