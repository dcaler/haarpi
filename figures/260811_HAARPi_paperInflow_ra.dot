// figure: paperInflow
// caption: Information-flow map: what each release feeds in the paper.
// provenance: mode=conceptual, author=Claude, from=raconteur context loaders + the drill-down's minted artifacts
digraph paperInflow {
  rankdir=LR; bgcolor="#ffffff"; compound=true;
  labelloc=t;
  label=<<FONT POINT-SIZE="20" FACE="Helvetica-Bold"><B>Information-flow map &#8212; what each release feeds in the paper</B></FONT><BR/><BR/><FONT POINT-SIZE="11.5" FACE="Helvetica">Sources are the same folders as the drill-down: <B>blue = a minted release</B>, <B>grey = a produced component</B>.<BR/><B>Solid</B> = the section&#8217;s prose is written from this source &#160;&#183;&#160; <B>dashed</B> = it supplies an asset (a citation or figure) placed there &#160;&#183;&#160; <B>dotted</B> = summarised into the abstract.</FONT>>;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#334155", fontname="Helvetica", fontsize=9];
  nodesep=0.3; ranksep=3.8;

  subgraph cluster_src {
    label="SOURCES  (the minted releases + one component)"; fontname="Helvetica-Bold"; fontsize=12; color="#94a3b8"; style=rounded;
    s_one  [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: the one-pager"];
    s_skel [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: the skeleton\n(sections + the words each affords)"];
    s_out  [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: the outline\n(content beats on the approved skeleton)"];
    s_lit  [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: literature review\nload-bearing sources + annotated bibliography"];
    s_pre  [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: the preregistration"];
    s_meth [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: the methods digest"];
    s_fig  [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: the figures pool"];
    s_res  [shape=folder, style=filled, fillcolor="#c7d2fe", color="#4f46e5", label="Artifact: the results write-up"];
    s_refs [shape=folder, style=filled, fillcolor="#e2e8f0", color="#94a3b8", label="Artifact: refs.bib"];
    s_refs -> s_res -> s_fig -> s_meth -> s_pre -> s_lit -> s_out -> s_skel -> s_one [style=invis, weight=100];
    { rank=same; s_one s_skel s_out s_lit s_pre s_meth s_fig s_res s_refs }
  }

  subgraph cluster_paper {
    label="Artifact: the manuscript .docx   (IBMRDC spine, top to bottom - a venue may override)"; fontname="Helvetica-Bold"; fontsize=12; color="#4f46e5"; penwidth=2; style="rounded,filled"; fillcolor="#dfe4fb";
    p_abs  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="Abstract"];
    p_int  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="Introduction"];
    p_bg   [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="Background"];
    p_meth [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="Methods"];
    p_res  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="Results"];
    p_dis  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="Discussion"];
    p_con  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="Conclusion"];
    p_ref  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6366f1", label="References\n(auto-built from refs.bib)"];
    p_ref -> p_con -> p_dis -> p_res -> p_meth -> p_bg -> p_int -> p_abs [style=invis, weight=100];
    { rank=same; p_abs p_int p_bg p_meth p_res p_dis p_con p_ref }
  }

  // anchor top-to-top so the two columns line up
  s_one -> p_abs [style=invis];
  edge [constraint=false];

  // STRUCTURE: the one-pager becomes the outline (in artifact space); the outline defines the sections
  s_one -> s_skel [color="#334155", label="the through-line"];
  s_skel -> s_out [color="#334155", label="the approved structure"];
  s_out -> p_bg [color="#334155", penwidth=1.8, lhead=cluster_paper, label="defines the section structure"];

  // CONTENT (solid): the section's prose is written from here
  s_lit -> p_int [color="#334155", label="motivation"];
  s_lit -> p_bg  [color="#334155", penwidth=1.8, label="the background pillars"];
  s_lit -> p_dis [color="#334155", label="vs. prior work"];
  s_pre -> p_meth [color="#334155", label="design + hypotheses"];
  s_pre -> p_dis [color="#334155", label="pre-registered vs. observed"];
  s_meth -> p_meth [color="#334155", penwidth=1.8, label="what the code does"];
  s_res -> p_res [color="#334155", penwidth=1.8, label="the findings"];
  s_res -> p_dis [color="#334155", label="interpretation"];

  // ASSETS (dashed): a citation or a figure placed in the section
  s_fig -> p_meth [color="#334155", style=dashed, label="framework + module figures"];
  s_fig -> p_res  [color="#334155", style=dashed, label="DAG + data figures"];
  s_refs -> p_bg  [color="#334155", style=dashed, label="grounds the [@key] citations (whole corpus)"];
  s_refs -> p_ref [color="#334155", style=dashed, label="only the CITED subset appears (citeproc)"];

  // the abstract is written LAST, summarising the finished body - routed up the RIGHT of the paper column
  p_int -> p_abs [color="#94a3b8", style=dotted, arrowsize=0.5, tailport=e, headport=e]; p_meth -> p_abs [color="#94a3b8", style=dotted, arrowsize=0.5, tailport=e, headport=e];
  p_res -> p_abs [color="#94a3b8", style=dotted, arrowsize=0.5, tailport=e, headport=e]; p_dis -> p_abs [color="#94a3b8", style=dotted, arrowsize=0.5, tailport=e, headport=e];
  p_con -> p_abs [color="#94a3b8", style=dotted, arrowsize=0.5, tailport=e, headport=e];
}
